{
  "name": "vue3-laravel-admin",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:test": "node scripts/dev.mjs --testing",
    "admin:create": "node scripts/backend.mjs admin:create",
    "access:replay": "node scripts/backend.mjs access:replay",
    "test:seed": "node scripts/backend.mjs test:seed",
    "dev:desktop": "node scripts/dev.mjs --desktop",
    "typecheck": "pnpm --dir frontend typecheck",
    "lint": "pnpm --dir frontend lint:check",
    "fmt": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:backend",
    "check:backend": "node scripts/backend.mjs check",
    "test": "node --test scripts/tests/*.test.mjs frontend/tests/*.test.ts && node scripts/backend.mjs test",
    "test:mysql": "node scripts/backend.mjs test:mysql",
    "build:web": "pnpm --dir frontend build",
    "build:desktop": "node scripts/desktop.mjs build",
    "db:migrate": "node scripts/backend.mjs migrate",
    "prepare": "simple-git-hooks",
    "install:local": "pnpm --dir frontend install --frozen-lockfile && composer --working-dir=backend install",
    "docker:up": "node scripts/docker.mjs up",
    "docker:update": "node scripts/docker.mjs update",
    "docker:down": "node scripts/docker.mjs down",
    "api:generate": "node scripts/openapi.mjs",
    "api:check": "node scripts/openapi.mjs --check",
    "icons:generate": "node scripts/icons.mjs",
    "build:desktop:test": "node scripts/desktop.mjs build --mode testing",
    "dev:desktop:test": "node scripts/dev.mjs --desktop --testing",
    "check:desktop": "pnpm build:web && cargo fmt --manifest-path frontend/src-tauri/Cargo.toml --check && cargo clippy --manifest-path frontend/src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "test:e2e": "node scripts/backend.mjs test:seed && pnpm --dir frontend exec playwright test",
    "ci:env": "node scripts/ci-env.mjs",
    "test:desktop": "node scripts/native-e2e.mjs",
    "upstream:check": "node scripts/upstream-check.mjs"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "prettier": "3.6.2",
    "simple-git-hooks": "2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check",
    "commit-msg": "node scripts/verify-commit.mjs"
  },
  "version": "0.1.1"
}
